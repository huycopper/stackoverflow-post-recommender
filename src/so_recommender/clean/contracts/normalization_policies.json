{
  "ID": {"target_type": "INTEGER", "output_type": "BIGINT", "min_value": 1, "max_value": null},
  "SCORE": {"target_type": "INTEGER", "output_type": "INT", "min_value": null, "max_value": null},
  "COUNT": {"target_type": "INTEGER", "output_type": "INT", "min_value": 0, "max_value": null},
  "BOOLEAN_DEFAULT": {"target_type": "BOOLEAN"},
  "POST_DATE": {
    "target_type": "INSTANT",
    "min_value": "2008-07-01T00:00:00Z",
    "allow_future": false
  },
  "TITLE": {"target_type": "TEXT", "min_length": 1, "max_length": 300},
  "LINK": {"target_type": "TEXT", "min_length": 1, "max_length": 2000},
  "POST_BODY": {
    "target_type": "TEXT",
    "code_column": "body_code",
    "short_text_warning_length": 30
  },
  "COMMENT_TEXT": {"target_type": "TEXT", "min_length": 1},
  "TAGS_DEFAULT": {"target_type": "TEXT_LIST", "replace_synonyms": true, "min_items": 1},
  "CLOSED_REASON": {
    "target_type": "TEXT",
    "allowed_values": [
      "Duplicate",
      "exact duplicate",
      "Not suitable for this site",
      "Needs details or clarity",
      "Needs more focus",
      "Opinion-based",
      "not constructive",
      "not a real question",
      "off topic",
      "too localized"
    ]
  },
  "USER_TYPE": {
    "target_type": "TEXT",
    "allowed_values": ["registered", "unregistered", "moderator", "team_admin", "does_not_exist"],
    "warn_values": ["does_not_exist"]
  }
}
